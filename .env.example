# ---- Backend ----
PORT=5000
# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/employee_management
# CORS origins (comma-separated). Not needed when UI and API share a domain.
CLIENT_ORIGIN=http://localhost:5173
# true = in-memory MongoDB for local testing (no install needed, data resets on restart)
USE_MEMORY_DB=false

# ---- Frontend ----
# Leave empty: the UI calls /api on the same domain (Vite proxies it in dev).
VITE_API_URL=
