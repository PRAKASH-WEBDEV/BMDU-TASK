{
  "name": "employee-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Employee Management System - MERN (React + Express + MongoDB) in one project",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:memory": "concurrently -n api,web -c blue,magenta \"npm:dev:api:memory\" \"npm:dev:web\"",
    "dev:api": "cross-env PORT=5000 node --watch backend/server.js",
    "dev:api:memory": "cross-env PORT=5000 USE_MEMORY_DB=true node --watch backend/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node backend/server.js",
    "start:memory": "cross-env USE_MEMORY_DB=true node backend/server.js",
    "seed": "node backend/seed.js",
    "test:api": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "mongodb-memory-server-core": "^10.4.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
