{
  "name": "ems-server",
  "version": "1.0.0",
  "description": "Employee Management System - REST API (Express + MongoDB)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "cross-env USE_MEMORY_DB=true node --watch src/server.js",
    "seed": "node src/seed.js",
    "test:api": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.3"
  }
}
